          "title": "Attached Assertion Case Ids",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "max_output_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_requests": {
          "exclusiveMinimum": 0,
          "title": "Max Requests",
          "type": "integer"
        },
        "mode": {
          "enum": [
            "non_thinking",
            "thinking"
          ],
          "title": "Mode",
          "type": "string"
        },
        "oracle": {
          "additionalProperties": true,
          "title": "Oracle",
          "type": "object"
        },
        "protocol": {
          "enum": [
            "chat",
            "responses"
          ],
          "title": "Protocol",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "rule_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Rule Ids",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "steps": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "stream": {
          "title": "Stream",
          "type": "boolean"
        },
        "template_id": {
          "minLength": 1,
          "title": "Template Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "protocol",
        "template_id",
        "mode",
        "stream",
        "rule_ids",
        "steps",
        "required",
        "max_requests",
        "max_output_tokens",
        "oracle"
      ],
      "title": "Case",
      "type": "object"
    },
    "Endpoint": {
      "additionalProperties": false,
      "properties": {
        "api_key_env": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key Env"
        },
        "auth_none": {
          "default": false,
          "title": "Auth None",
          "type": "boolean"
        },
        "base_url": {
          "format": "uri",
          "minLength": 1,
          "title": "Base Url",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "model_release": {
          "minLength": 1,
          "title": "Model Release",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "base_url",
        "model",
        "model_release"
      ],
      "title": "Endpoint",
      "type": "object"
    },
    "PlanBudgets": {
      "additionalProperties": false,
