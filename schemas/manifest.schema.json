      "type": "integer"
    },
    "profile_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Profile Hash",
      "type": "string"
    },
    "request_ceiling": {
      "minimum": 0,
      "title": "Request Ceiling",
      "type": "integer"
    },
