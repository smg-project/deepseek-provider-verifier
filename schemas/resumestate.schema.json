{
  "$defs": {
    "AssertionResult": {
      "additionalProperties": false,
      "properties": {
        "gating": {
          "default": false,
          "title": "Gating",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "observed": {
          "default": null,
          "title": "Observed"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "rule_ids": {
          "items": {
            "type": "string"
          },
          "title": "Rule Ids",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "ERROR",
            "SKIP",
            "INCONCLUSIVE"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "status",
        "reason"
      ],
      "title": "AssertionResult",
      "type": "object"
    },
    "Attempt": {
      "additionalProperties": false,
      "properties": {
        "attempt_number": {
          "exclusiveMinimum": 0,
          "title": "Attempt Number",
          "type": "integer"
        },
        "capture": {
          "additionalProperties": true,
          "title": "Capture",
          "type": "object"
        },
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "endpoint": {
          "minLength": 1,
          "title": "Endpoint",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "events": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Events",
          "type": "array"
        },
        "evidence_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Hash",
          "type": "string"
        },
        "prompt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Id"
        },
        "repetition": {
          "minimum": 0,
          "title": "Repetition",
          "type": "integer"
        },
        "request": {
          "additionalProperties": true,
          "title": "Request",
          "type": "object"
        },
        "request_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Hash",
          "type": "string"
        },
        "response": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response"
        },
        "retry": {
          "default": 0,
          "minimum": 0,
          "title": "Retry",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status_code": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status Code"
        },
        "step": {
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "timings": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Timings",
          "type": "object"
        }
      },
      "required": [
        "case_id",
        "endpoint",
        "step",
        "repetition",
        "attempt_number",
        "request_hash",
        "request",
        "timings",
        "events",
        "evidence_hash"
      ],
      "title": "Attempt",
      "type": "object"
    },
    "CaseResult": {
      "additionalProperties": false,
      "properties": {
        "assertions": {
          "items": {
            "$ref": "#/$defs/AssertionResult"
          },
          "title": "Assertions",
          "type": "array"
        },
        "attempt_refs": {
          "items": {
            "type": "string"
          },
          "title": "Attempt Refs",
          "type": "array"
        },
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "completed": {
          "default": true,
          "title": "Completed",
          "type": "boolean"
        },
        "endpoint": {
          "minLength": 1,
          "title": "Endpoint",
          "type": "string"
        },
        "eventual_status": {
          "anyOf": [
            {
              "enum": [
                "PASS",
                "FAIL",
                "ERROR",
                "SKIP",
                "INCONCLUSIVE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eventual Status"
        },
        "first_attempt_status": {
          "anyOf": [
            {
              "enum": [
                "PASS",
                "FAIL",
                "ERROR",
                "SKIP",
                "INCONCLUSIVE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Attempt Status"
        },
        "metric_observations": {
          "items": {
            "$ref": "#/$defs/MetricObservation"
          },
          "title": "Metric Observations",
          "type": "array"
        },
        "prompt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Id"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "repetition": {
          "default": 0,
          "minimum": 0,
          "title": "Repetition",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "ERROR",
            "SKIP",
            "INCONCLUSIVE"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "endpoint",
        "status",
        "assertions",
        "metric_observations",
        "attempt_refs"
      ],
      "title": "CaseResult",
      "type": "object"
    },
    "MetricObservation": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "default": 1,
          "title": "Denominator",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scored": {
          "default": true,
          "title": "Scored",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "name"
      ],
      "title": "MetricObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "completed_case_ids": {
      "items": {
        "type": "string"
      },
      "title": "Completed Case Ids",
      "type": "array"
    },
    "incomplete_records": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Incomplete Records",
      "type": "array"
    },
    "manifest_hash": {
      "title": "Manifest Hash",
      "type": "string"
    },
    "prior_attempts": {
      "items": {
        "$ref": "#/$defs/Attempt"
      },
      "title": "Prior Attempts",
      "type": "array"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/CaseResult"
      },
      "title": "Results",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "manifest_hash"
  ],
  "title": "ResumeState",
  "type": "object"
}
