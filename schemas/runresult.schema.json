{
  "$defs": {
    "AssertionResult": {
      "additionalProperties": false,
      "properties": {
        "gating": {
          "default": false,
          "title": "Gating",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "observed": {
          "default": null,
          "title": "Observed"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "rule_ids": {
          "items": {
            "type": "string"
          },
          "title": "Rule Ids",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "ERROR",
            "SKIP",
            "INCONCLUSIVE"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "status",
        "reason"
      ],
      "title": "AssertionResult",
      "type": "object"
    },
    "AttemptMetric": {
      "additionalProperties": false,
      "description": "Content-free HTTP attempt projection retained in run summaries.",
      "properties": {
        "attempt_number": {
          "exclusiveMinimum": 0,
          "title": "Attempt Number",
          "type": "integer"
        },
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "endpoint": {
          "minLength": 1,
          "title": "Endpoint",
          "type": "string"
        },
        "error_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Type"
        },
        "http_exchange_completed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Exchange Completed"
        },
        "interrupted_reservation": {
          "default": false,
          "title": "Interrupted Reservation",
          "type": "boolean"
        },
        "prompt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Id"
        },
        "repetition": {
          "minimum": 0,
          "title": "Repetition",
          "type": "integer"
        },
        "retry": {
          "minimum": 0,
          "title": "Retry",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status_code": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status Code"
        },
        "step": {
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "timings": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Timings",
          "type": "object"
        }
      },
      "required": [
        "endpoint",
        "case_id",
        "repetition",
        "step",
        "retry",
        "attempt_number"
      ],
      "title": "AttemptMetric",
      "type": "object"
    },
    "CaseResult": {
      "additionalProperties": false,
      "properties": {
        "assertions": {
          "items": {
            "$ref": "#/$defs/AssertionResult"
          },
          "title": "Assertions",
          "type": "array"
        },
        "attempt_refs": {
          "items": {
            "type": "string"
          },
          "title": "Attempt Refs",
          "type": "array"
        },
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "completed": {
          "default": true,
          "title": "Completed",
          "type": "boolean"
        },
        "endpoint": {
          "minLength": 1,
          "title": "Endpoint",
          "type": "string"
        },
        "eventual_status": {
          "anyOf": [
            {
              "enum": [
                "PASS",
                "FAIL",
                "ERROR",
                "SKIP",
                "INCONCLUSIVE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eventual Status"
        },
        "first_attempt_status": {
          "anyOf": [
            {
              "enum": [
                "PASS",
                "FAIL",
                "ERROR",
                "SKIP",
                "INCONCLUSIVE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Attempt Status"
        },
        "metric_observations": {
          "items": {
            "$ref": "#/$defs/MetricObservation"
          },
          "title": "Metric Observations",
          "type": "array"
        },
        "prompt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Id"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "repetition": {
          "default": 0,
          "minimum": 0,
          "title": "Repetition",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "ERROR",
            "SKIP",
            "INCONCLUSIVE"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "endpoint",
        "status",
        "assertions",
        "metric_observations",
        "attempt_refs"
      ],
      "title": "CaseResult",
      "type": "object"
    },
    "MetricObservation": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "default": 1,
          "title": "Denominator",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scored": {
          "default": true,
          "title": "Scored",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "name"
      ],
      "title": "MetricObservation",
      "type": "object"
    },
    "RunReportContext": {
      "additionalProperties": false,
      "description": "Portable provenance needed to render a stored run result.",
      "properties": {
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "dataset_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Hash"
        },
        "endpoints": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Endpoints",
          "type": "object"
        },
        "evidence_links": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Evidence Links",
          "type": "object"
        },
        "integrity": {
          "default": "unavailable",
          "enum": [
            "verified",
            "summary-only",
            "unavailable"
          ],
          "title": "Integrity",
          "type": "string"
        },
        "profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile"
        },
        "profile_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Hash"
        },
        "required_case_ids": {
          "items": {
            "type": "string"
          },
          "title": "Required Case Ids",
          "type": "array"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "title": "RunReportContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actual_concurrency": {
      "default": 1,
      "exclusiveMinimum": 0,
      "title": "Actual Concurrency",
      "type": "integer"
    },
    "attempt_metrics": {
      "items": {
        "$ref": "#/$defs/AttemptMetric"
      },
      "title": "Attempt Metrics",
      "type": "array"
    },
    "budget_usage": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Budget Usage",
      "type": "object"
    },
    "case_results": {
      "items": {
        "$ref": "#/$defs/CaseResult"
      },
      "title": "Case Results",
      "type": "array"
    },
    "complete": {
      "title": "Complete",
      "type": "boolean"
    },
    "counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Counts",
      "type": "object"
    },
    "enabled_gates": {
      "items": {
        "type": "string"
      },
      "title": "Enabled Gates",
      "type": "array"
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2
      ],
      "title": "Exit Code",
      "type": "integer"
    },
    "manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Hash",
      "type": "string"
    },
    "report": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunReportContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "resume_dispositions": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Resume Dispositions",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "manifest_hash",
    "complete",
    "case_results",
    "counts",
    "budget_usage",
    "enabled_gates",
    "exit_code"
  ],
  "title": "RunResult",
  "type": "object"
}
