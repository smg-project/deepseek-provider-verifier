{
  "additionalProperties": false,
  "description": "Portable provenance needed to render a stored run result.",
  "properties": {
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "dataset_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Hash"
    },
    "endpoints": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Endpoints",
      "type": "object"
    },
    "evidence_links": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Evidence Links",
      "type": "object"
    },
    "integrity": {
      "default": "unavailable",
      "enum": [
        "verified",
        "summary-only",
        "unavailable"
      ],
      "title": "Integrity",
      "type": "string"
    },
    "profile": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile"
    },
    "profile_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile Hash"
    },
    "required_case_ids": {
      "items": {
        "type": "string"
      },
      "title": "Required Case Ids",
      "type": "array"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "title": "RunReportContext",
  "type": "object"
}
