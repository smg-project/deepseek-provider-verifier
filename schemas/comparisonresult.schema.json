{
  "$defs": {
    "ComparisonMetric": {
      "additionalProperties": false,
      "properties": {
        "bootstrap_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bootstrap Seed"
        },
        "confidence_level": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Level"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "denominator": {
          "minimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "difference": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Difference"
        },
        "lower_bound": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower Bound"
        },
        "missing_candidate": {
          "default": 0,
          "minimum": 0,
          "title": "Missing Candidate",
          "type": "integer"
        },
        "missing_reference": {
          "default": 0,
          "minimum": 0,
          "title": "Missing Reference",
          "type": "integer"
        },
        "numerator": {
          "default": 0,
          "title": "Numerator",
          "type": "number"
        },
        "paired_distinct_prompts": {
          "default": 0,
          "minimum": 0,
          "title": "Paired Distinct Prompts",
          "type": "integer"
        },
        "paired_observations": {
          "default": 0,
          "minimum": 0,
          "title": "Paired Observations",
          "type": "integer"
        },
        "paired_repetitions": {
          "default": 0,
          "minimum": 0,
          "title": "Paired Repetitions",
          "type": "integer"
        },
        "reference_denominator": {
          "minimum": 0,
          "title": "Reference Denominator",
          "type": "integer"
        },
        "reference_numerator": {
          "default": 0,
          "title": "Reference Numerator",
          "type": "number"
        },
        "reference_unavailable": {
          "minimum": 0,
          "title": "Reference Unavailable",
          "type": "integer"
        },
        "reference_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Value"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "unavailable": {
          "minimum": 0,
          "title": "Unavailable",
          "type": "integer"
        },
        "upper_bound": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper Bound"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "denominator",
        "unavailable",
        "reference_denominator",
        "reference_unavailable"
      ],
      "title": "ComparisonMetric",
      "type": "object"
    },
    "ComparisonPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowed_drops": {
          "additionalProperties": {
            "type": "number"
          },
          "minProperties": 1,
          "title": "Allowed Drops",
          "type": "object"
        },
        "bootstrap_samples": {
          "default": 2000,
          "exclusiveMinimum": 0,
          "title": "Bootstrap Samples",
          "type": "integer"
        },
        "bootstrap_seed": {
          "title": "Bootstrap Seed",
          "type": "integer"
        },
        "confidence_level": {
          "title": "Confidence Level",
          "type": "number"
        },
        "minimum_distinct_prompts": {
          "minimum": 2,
          "title": "Minimum Distinct Prompts",
          "type": "integer"
        },
        "minimum_repetitions": {
          "exclusiveMinimum": 0,
          "title": "Minimum Repetitions",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "allowed_drops",
        "minimum_distinct_prompts",
        "minimum_repetitions",
        "confidence_level",
        "bootstrap_seed"
      ],
      "title": "ComparisonPolicy",
      "type": "object"
    },
    "ComparisonReportContext": {
      "additionalProperties": false,
      "description": "Portable provenance needed to render a stored comparison result.",
      "properties": {
        "case_count": {
          "minimum": 0,
          "title": "Case Count",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "dataset_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Hash"
        },
        "enabled_gates": {
          "items": {
            "type": "string"
          },
          "title": "Enabled Gates",
          "type": "array"
        },
        "endpoint_models": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Endpoint Models",
          "type": "object"
        },
        "evidence_links": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Evidence Links",
          "type": "object"
        },
        "exit_code": {
          "anyOf": [
            {
              "enum": [
                0,
                1,
                2
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "integrity": {
          "default": "unavailable",
          "enum": [
            "verified",
            "summary-only",
            "unavailable"
          ],
          "title": "Integrity",
          "type": "string"
        },
        "profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile"
        },
        "profile_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Hash"
        },
        "quality_verdict": {
          "anyOf": [
            {
              "enum": [
                "PASS",
                "FAIL",
                "INCONCLUSIVE",
                "REPORT_ONLY"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Verdict"
        },
        "required_case_count": {
          "minimum": 0,
          "title": "Required Case Count",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "PASS",
              "FAIL",
              "ERROR",
              "SKIP",
              "INCONCLUSIVE"
            ]
          },
          "title": "Status Counts",
          "type": "object"
        }
      },
      "required": [
        "created_at",
        "case_count",
        "required_case_count"
      ],
      "title": "ComparisonReportContext",
      "type": "object"
    },
    "ManifestDifference": {
      "additionalProperties": false,
      "properties": {
        "candidate": {
          "title": "Candidate"
        },
        "compatible": {
          "default": false,
          "title": "Compatible",
          "type": "boolean"
        },
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "reference": {
          "title": "Reference"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "field",
        "reference",
        "candidate",
        "reason"
      ],
      "title": "ManifestDifference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_endpoint": {
      "title": "Candidate Endpoint",
      "type": "string"
    },
    "comparable": {
      "title": "Comparable",
      "type": "boolean"
    },
    "manifest_differences": {
      "items": {
        "$ref": "#/$defs/ManifestDifference"
      },
      "title": "Manifest Differences",
      "type": "array"
    },
    "metric_gates": {
      "additionalProperties": {
        "enum": [
          "PASS",
          "FAIL",
          "INCONCLUSIVE"
        ],
        "type": "string"
      },
      "title": "Metric Gates",
      "type": "object"
    },
    "metrics": {
      "additionalProperties": {
        "$ref": "#/$defs/ComparisonMetric"
      },
      "title": "Metrics",
      "type": "object"
    },
    "policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/ComparisonPolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "quality_gate": {
      "anyOf": [
        {
          "enum": [
            "PASS",
            "FAIL",
            "INCONCLUSIVE"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quality Gate"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "reference_endpoint": {
      "title": "Reference Endpoint",
      "type": "string"
    },
    "report": {
      "anyOf": [
        {
          "$ref": "#/$defs/ComparisonReportContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "comparable",
    "reference_endpoint",
    "candidate_endpoint",
    "manifest_differences",
    "metrics"
  ],
  "title": "ComparisonResult",
  "type": "object"
}
